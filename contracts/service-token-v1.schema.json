{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:plat:contracts:gateway:service-token:v1",
  "title": "Kense gateway service token claims",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "iss", "aud", "sub", "iat", "exp", "tenant", "project", "env", "org", "plane", "urn", "operation", "method", "path", "request_id", "trace_id", "reservation_id", "deployments"],
  "properties": {
    "v": {"const": 1},
    "iss": {"$ref": "#/$defs/identifier"},
    "aud": {"$ref": "#/$defs/identifier"},
    "sub": {"$ref": "#/$defs/identifier"},
    "iat": {"type": "integer", "minimum": 0},
    "exp": {"type": "integer", "minimum": 0},
    "tenant": {"$ref": "#/$defs/identifier"},
    "project": {"$ref": "#/$defs/identifier"},
    "env": {"$ref": "#/$defs/identifier"},
    "org": {"$ref": "#/$defs/identifier"},
    "plane": {"const": "tenant"},
    "urn": {"type": "string", "pattern": "^urn:plat:[A-Za-z0-9._:-]+$", "maxLength": 256},
    "operation": {"$ref": "#/$defs/identifier"},
    "action": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,64}$"},
    "method": {"enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]},
    "path": {"type": "string", "pattern": "^/[^?#\\s]*$", "maxLength": 256},
    "query": {"type": "string", "pattern": "^[A-Za-z0-9_=&-]+$", "maxLength": 256},
    "request_id": {"$ref": "#/$defs/uuid"},
    "trace_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "reservation_id": {"$ref": "#/$defs/uuid"},
    "vault_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secret_ref", "version"],
      "properties": {
        "secret_ref": {"type": "string", "pattern": "^urn:plat:vault:secret:[A-Za-z0-9._:-]{1,128}$"},
        "version": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      }
    },
    "on_behalf_of": {"$ref": "#/$defs/identifier"},
    "delegation_chain": {
      "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_requests", "targets"],
      "properties": {
        "max_requests": {"type": "integer", "minimum": 1, "maximum": 50000},
        "targets": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {"$ref": "#/$defs/deployment"}
        }
      }
    },
    "deployments": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/deployment"}
    },
    "model_aliases": {
      "description": "MaaS model discovery aliases. Each ID must appear once and refer to an entry in deployments.",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": {"$ref": "#/$defs/identifier"},
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 64,
        "uniqueItems": true,
        "items": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      }
    }
  },
  "if": {"required": ["model_aliases"]},
  "then": {"properties": {
    "aud": {"const": "urn:plat:maas:kstack"},
    "operation": {"const": "maas.models.list"},
    "method": {"const": "GET"},
    "path": {"const": "/v1/models"},
    "urn": {"const": "urn:plat:maas:models"}
  }},
  "$defs": {
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "version": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}
  }
}
