{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:plat:contracts:gateway:vault-envelope:v1",
  "title": "Vault redemption envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ciphertext", "key_id"],
  "properties": {
    "schema": { "const": "kgateway.vault-envelope.v1" },
    "ciphertext": {
      "description": "Canonical padded Base64 for the provider's sealed bytes. The control plane preserves these bytes without decrypting them.",
      "type": "string",
      "contentEncoding": "base64",
      "minLength": 24,
      "maxLength": 65536,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "key_id": {
      "description": "Provider key reference. The consumer matches it to its configured KMS key before decryption.",
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/-]{1,512}$"
    }
  }
}
